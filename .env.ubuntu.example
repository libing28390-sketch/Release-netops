# Native Ubuntu/systemd environment template. Docker Compose uses .env.example.
# The installer fills DATABASE_URL and generates SECRET_KEY/CREDENTIAL_ENCRYPTION_KEY.
TZ=Asia/Shanghai
DATABASE_URL=postgresql://nexora:YOUR_PASSWORD@localhost:5432/nexora
SECRET_KEY=replace-with-a-very-secret-key
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-32-char-random-secret-key
ENVIRONMENT=production
LOG_LEVEL=INFO

# Native Ubuntu uses local file storage and PostgreSQL telemetry by default.
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./data/storage
STORAGE_SPOOL_ROOT=./data/spool
MONITORING_METRIC_BACKEND=native
MONITORING_ARTIFACT_ROOT=./data/artifacts/monitoring
IP_LOCATOR_CACHE_BACKEND=postgres

# The native process handles the PostgreSQL notification outbox itself.
ALERT_NOTIFICATION_CELERY_ENABLED=0

# Keep external AI calls, web search, probes and metadata export opt-in.
AI_ENABLED=0
EXTERNAL_AI_ENABLED=0
AI_KILL_SWITCH=0
AI_DEBUG_PAYLOAD=0
AI_WEB_SEARCH_ENABLED=0
AI_MODEL_HEALTH_MONITOR_ENABLED=0
AI_DAILY_BUDGET_USD=0
AI_OBSERVABILITY_MODE=off
AI_RERANKER_MODE=legacy
AI_PARSER_MODE=legacy
AI_DOCUMENT_PARSER_MODE=legacy
