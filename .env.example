# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=netops
# For local dev outside docker, change 'db' to 'localhost'
DATABASE_URL=postgresql://postgres:postgres@db:5432/netops

# Redis / Celery Settings
REDIS_URL=redis://redis:6379/0

# App Settings
# Generate a random secret for production
SECRET_KEY=replace-with-a-very-secret-key
# 32-character encryption key for device credentials
CREDENTIAL_ENCRYPTION_KEY=netops-2026-topology-phase1-credential-master-key-r7QmLp92Xv
ENVIRONMENT=production
