# Nexora v1.0.9 Docker Compose deployment environment template.
# Native Ubuntu/systemd deployments use .env.ubuntu.example instead.
# Run scripts/deploy-docker.sh install to generate this file's required secrets.
# The helper generates the database, application, Grafana, S3 and cache Redis
# secrets. Set ALERT_NOTIFICATION_BROKER_PASSWORD manually before installation:
#   openssl rand -hex 32
# Required for Compose: POSTGRES_PASSWORD, POSTGRES_EXPORTER_PASSWORD,
# SECRET_KEY, CREDENTIAL_ENCRYPTION_KEY, GRAFANA_ADMIN_PASSWORD, and
# ALERT_NOTIFICATION_BROKER_PASSWORD. S3 credentials are required because this
# template selects STORAGE_BACKEND=s3. Direct Compose users must fill them too.
# Compose rejects empty required values, but does not reject literal placeholders.
# Container CPU/memory ceilings and defaults are defined in docker-compose.yml.
# Alert notifications use an isolated Redis broker with noeviction and AOF.
# Keep this value empty until you generate its URL-safe secret.
ALERT_NOTIFICATION_BROKER_PASSWORD=
# Local development runs the FastAPI process without Docker/Celery/Redis for
# alert delivery. Keep 0 to use the PostgreSQL outbox consumer in that process.
# Set to 1 only when a separate Relay/Worker deployment consumes the same DB.
# The Docker Compose deployment overrides this to 1 on the API service.
ALERT_NOTIFICATION_CELERY_ENABLED=0
ALERT_NOTIFICATION_RELAY_INTERVAL_SECONDS=0.5
ALERT_NOTIFICATION_RELAY_BATCH_SIZE=50
NGINX_WORKER_PROCESSES=1

# PostgreSQL credentials and connection for Docker Compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=netops
POSTGRES_EXPORTER_USER=nexora_metrics
POSTGRES_EXPORTER_PASSWORD=
# Limit the number of statement series returned by postgres_exporter.
PG_STAT_STATEMENTS_EXPORT_LIMIT=100
# PostgreSQL statement statistics (PostgreSQL restart required when changed).
# Append any additional preload modules as a comma-separated list.
POSTGRES_SHARED_PRELOAD_LIBRARIES=pg_stat_statements
PG_STAT_STATEMENTS_MAX=5000
PG_STAT_STATEMENTS_TRACK=top
PG_STAT_STATEMENTS_TRACK_PLANNING=off
# Compose builds each container URL from POSTGRES_* and the internal db service.
# The helper fills this host-side URL; direct Compose users need it for host backup tools.
DATABASE_URL=

# IP 定位共享缓存与 AI 限流使用的 Redis 地址。Docker Compose sidecar 使用
# ACL 用户 nexora 和服务名 redis。密码需 URL 编码。
REDIS_URL=redis://nexora@redis:6379/0
# The deployment helper generates this password and updates REDIS_URL.
# For direct Compose use, set a password; do not expose passwordless Redis.
REDIS_PASSWORD=

# ── Optional native LibreNMS runtime ────────────────────────────────────────
# These secrets are required only when --profile librenms-native is explicitly
# enabled. Keep values empty here so a fresh profile launch fails closed until
# independent secrets have been generated and entered in the local .env.
# Generate APP_KEY as: base64:$(openssl rand -base64 32 | tr -d '\n')
# Generate each password independently with: openssl rand -hex 32
LIBRENMS_APP_KEY=
LIBRENMS_DB_PASSWORD=
LIBRENMS_DB_ROOT_PASSWORD=
LIBRENMS_REDIS_PASSWORD=
# Must name a pre-created Docker network with a host route to the device
# management VLAN. monitoring_internal is isolated and must not be used here.
LIBRENMS_DEVICE_NETWORK_NAME=nexora-librenms-device-management

# ── Monitoring V1 / Metric Provider ─────────────────────────────────────────
# Docker Compose uses the Prometheus-compatible VictoriaMetrics path by default.
# native and shadow are migration modes for an explicitly planned cutover.
MONITORING_METRIC_BACKEND=victoriametrics
VICTORIAMETRICS_URL=http://victoriametrics:8428
VICTORIAMETRICS_ALLOWED_HOSTS=victoriametrics,localhost,127.0.0.1
MONITORING_ARTIFACT_ROOT=./artifacts/monitoring
# Historical metric retention. Expired data is reclaimed by background cleanup.
VM_RETENTION_PERIOD=30d
# Stop metric ingestion below 10 GiB free on the /storage filesystem.
# This protects VictoriaMetrics, not disk writes by other containers.
VM_MIN_FREE_DISK_SPACE_BYTES=10737418240
# Retry queue cap per remote-write URL. A full queue discards oldest samples.
VMAGENT_MAX_DISK_USAGE=1GB

# Grafana global monitoring dashboards. Set this to the exact HTTPS URL that
# LAN users enter in their browser, including the trailing slash. For example:
#   https://192.168.1.100/grafana/
#   https://nexora.example.com/grafana/
# The Docker deployment helper replaces this placeholder with TLS_COMMON_NAME.
GRAFANA_ROOT_URL=https://replace-with-your-server-host/grafana/
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password
GRAFANA_ANONYMOUS_ENABLED=0
GRAFANA_ALLOW_EMBEDDING=1
# Private Docker subnet trusted by Grafana's auth proxy; only attach Grafana and Nginx.
# Change this if the default subnet conflicts with another Docker network.
GRAFANA_AUTH_PROXY_SUBNET=172.30.254.0/29

# IP 定位固定使用 SSH/CLI 四阶段流程；其他 TTL/并发使用程序默认值。
# 完整拓扑 LLDP 快照：48 小时逻辑新鲜、72 小时 Redis 物理保留。
IP_LOCATOR_TOPOLOGY_FRESH_SECONDS=172800
IP_LOCATOR_TOPOLOGY_RETAIN_SECONDS=259200
# Redis 仅作可重建缓存，事实和任务状态仍存 PostgreSQL，不使用 SNMP。

# 应用基础配置
# 生产环境建议生成随机密钥
# Docker Compose 会将本文件作为 netops 服务的运行时环境文件加载；
# Compose 中明确声明的 Docker 内部地址和生产环境标识会覆盖本文件对应值。
TZ=Asia/Shanghai
SECRET_KEY=replace-with-a-very-secret-key
# 32位设备凭据加密密钥
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-32-char-random-secret-key
ENVIRONMENT=production
LOG_LEVEL=INFO
# Local development disables automatic alert/channel dispatch by default so
# existing database webhooks are not contacted during startup.
# Set explicitly to 1 only for an intentional local notification test.
# NEXORA_AUTOMATIC_NOTIFICATIONS_ENABLED=1
# Backend file-log safety limits. The active file is 10 MiB and five
# compressed backups are retained; Docker stdout/stderr has its own limit.
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5
REQUEST_BODY_MAX_BYTES=157286400
SESSION_TTL_SECONDS=7200
PLAYBOOK_RAW_OUTPUT_RETENTION_DAYS=30
LOG_SLOW_REQUEST_MS=500

# ── Blob storage ────────────────────────────────────────────────────────────
# s3 is the Docker deployment default and connects to the internal SeaweedFS
# `weed mini` endpoint. The deployment script replaces the two marked
# credential placeholders with strong per-installation values. The application
# never silently falls back between providers.
STORAGE_BACKEND=s3
STORAGE_LOCAL_ROOT=./data/storage
STORAGE_SPOOL_ROOT=./data/spool
STORAGE_RETRY_INTERVAL_SECONDS=60
# The Compose SeaweedFS service is reachable by its service name from netops.
# Replace this URL when using an external S3-compatible provider.
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_BUCKET=nexora
S3_ACCESS_KEY_ID=replace-with-a-strong-s3-access-key
S3_SECRET_ACCESS_KEY=replace-with-a-strong-s3-secret-key
S3_FORCE_PATH_STYLE=true
S3_VERIFY_TLS=true
S3_CONNECT_TIMEOUT_SECONDS=5
S3_READ_TIMEOUT_SECONDS=60

# Workstation Agent downloads are selected by the browser workstation OS.
# The server remains Linux/Docker-only; Windows users still need this local
# Agent to launch the browser/terminal against the remote Nexora server.
TERMINAL_AGENT_WINDOWS_URL=https://github.com/libing28390-sketch/Release-netops/releases/latest/download/NexoraTerminalAgent.exe

# ── AI Provider / Security Gateway / Embedding ──────────────────────────────
# External AI is opt-in.  Provider API keys are entered through the encrypted
# Provider UI or injected by a secret manager; never place a real key here.
# AI 功能总开关：1=启用 AI 功能，0=禁用 AI 功能。
AI_ENABLED=0
# 外部 AI 出口开关：1=允许请求发送到 DeepSeek 等外部 Provider，0=禁止外发。
EXTERNAL_AI_ENABLED=0
# AI 紧急熔断开关：1=立即阻断所有 AI 外部调用，0=按正常安全策略执行。
AI_KILL_SWITCH=0
# AI 临时测试模式在 /ai/security 页面由管理员按时长开启，最多 15 分钟；不需要在此配置。
AI_SECURITY_VAULT_TTL_SECONDS=3600
AI_MAX_PAYLOAD_BYTES=256000
# Provider 类型白名单：只有列出的 Provider 类型可以通过 AI 安全网关调用。
AI_PROVIDER_ALLOWLIST=deepseek,openai,openai_compatible,azure_openai,ollama,local,qwen
AI_DEBUG_PAYLOAD=0
AI_OUTBOUND_PROXY_URL=
# 通用只读联网检索：用于实时/公开问题，以及本地网络知识库未命中后的公开参考检索。
# External search is a separate opt-in. Keep it off unless public web egress is approved.
AI_WEB_SEARCH_ENABLED=0
AI_WEB_SEARCH_ENDPOINT=https://html.duckduckgo.com/html/
# If search is enabled, an empty host list allows any public HTTPS result host;
# set a comma-separated host allowlist for a restricted deployment.
AI_WEB_ALLOWED_HOSTS=
AI_WEB_TIMEOUT_SECONDS=8
AI_WEB_MAX_RESULTS=5
AI_WEB_MAX_PAGE_FETCHES=3
AI_WEB_MAX_PAGE_CHARS=6000
AI_WEB_MAX_RESPONSE_BYTES=1000000
AI_PROVIDER_MAX_CONCURRENCY=8
AI_TENANT_MAX_CONCURRENCY=4
AI_USER_MAX_CONCURRENCY=2
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_COOLDOWN_SECONDS=30
AI_HEALTH_BACKOFF_SECONDS=30
# Set to 1 only if periodic provider probes are wanted; they can incur API usage.
AI_MODEL_HEALTH_MONITOR_ENABLED=0
AI_MODEL_HEALTH_INTERVAL_MINUTES=10
AI_MODEL_HEALTH_MAX_CONCURRENCY=2
AI_MODEL_HEALTH_MAX_TOKENS=64
AI_MODEL_HEALTH_RETENTION_DAYS=90
# 0 disables the spending limit. Set a positive daily USD cap before using paid providers.
AI_DAILY_BUDGET_USD=0

# Embedding is local/deterministic by default.  Set mode=disabled only when
# the deployment intentionally blocks embedding; dimensions must match the
# PostgreSQL vector contract before any index rebuild is approved.
AI_EMBEDDING_MODE=local
AI_EMBEDDING_DIMENSIONS=1536
AI_RETRIEVAL_CACHE_ENABLED=0
AI_RETRIEVAL_TRGM_THRESHOLD=0.35
# Configuration-scope guard: broad or ambiguous configuration requests first
# ask for feature/platform scope and do not expose KB document bodies.
AI_CONFIG_CLARIFICATION_ENABLED=1
AI_CONFIG_CLARIFICATION_ROLLOUT_PERCENT=100

# ── AI/RAG optional sidecars and observability ─────────────────────────────
# Keep the legacy path as the safe default.  Shadow/active require a target
# environment approval, a ready sidecar, and a rollback rehearsal.
AI_RERANKER_MODE=legacy
# This loopback endpoint is unused in legacy mode. Set a Compose-reachable host
# and allowlist before enabling shadow or active reranking.
AI_RERANKER_ENDPOINT=http://127.0.0.1:8004/v1/rerank
AI_RERANKER_TIMEOUT_MS=300

# Parser sidecar is opt-in; active is normalized to docling by the adapter.
AI_PARSER_MODE=legacy
AI_DOCUMENT_PARSER_MODE=legacy
AI_DOCLING_BASE_URL=
AI_DOCLING_TIMEOUT_SECONDS=10
AI_DOCLING_MAX_PAGES=50
AI_DOCLING_MAX_RESPONSE_BYTES=2000000
AI_DOCLING_OCR=0

# Metadata-only observability is opt-in. Hashed identifiers use AI_HASH_SALT
# when provided; otherwise the exporter derives them from SECRET_KEY.
AI_OBSERVABILITY_MODE=off
# This loopback endpoint is inactive while observability is off. Use a reachable,
# trusted Compose service before enabling metadata export.
LANGFUSE_METADATA_ENDPOINT=http://127.0.0.1:3000/api/public/ingestion
LANGFUSE_TIMEOUT_SECONDS=2

# ── Knowledge Engine / network safety settings ─────────────────────────────
NETWORK_WRITE_ENABLED=0
PRODUCTION_CREDENTIALS_ALLOWED=0

# Test/evaluation-only values.  Production should use a secret namespace and
# real credentials from the deployment secret manager, never this file.
AI_GATEWAY_MODE=offline
DATA_CLASSIFICATION=synthetic
DEVICE_CREDENTIAL_SOURCE=fixture

# [可选] 外部配置管理 API（供 GET /api/templates 接口调用）。
# 留空则默认使用 PostgreSQL 存储的本地模板库。
CONFIG_MANAGEMENT_URL=
CONFIG_MANAGEMENT_TIMEOUT_SECONDS=1

# PostgreSQL 数据库连接池安全设置。限制溢出连接数，防止突发流量耗尽数据库会话和文件描述符。
DB_POOL_SIZE=16
# 每个后端进程预建并保留的空闲连接数（1..DB_POOL_SIZE）。默认等于 DB_POOL_SIZE，
# 避免并发请求后反复建连；总连接预算为每进程 DB_POOL_SIZE + DB_POOL_OVERFLOW_MAX。
DB_POOL_MIN_SIZE=16
DB_POOL_OVERFLOW_MAX=4
DB_POOL_ACQUIRE_TIMEOUT_SECONDS=10

# 针对高频访问的 GET /api/templates 接口的短暂读取缓存。
TEMPLATES_CACHE_TTL_SECONDS=2

# Dashboard read projections. These are process-local short caches; mutations
# invalidate their namespace immediately. Set to 0 to disable a cache.
READ_CACHE_TOPOLOGY_SECONDS=10
READ_CACHE_PLAYBOOKS_SECONDS=5
READ_CACHE_SCHEDULED_JOBS_SECONDS=5
READ_CACHE_RACKS_SECONDS=10
READ_CACHE_REFERENCES_SECONDS=30

# Keep legacy filename/catalog consumers explicit during staged migration.
# Set both to 0 only after the migration preview is clean and all devices are
# bound to a published platform Release.
LEGACY_TEXTFSM_FILE_FALLBACK_ENABLED=1
LEGACY_COMMAND_CATALOG_ENABLED=1

# 定时任务调度器安全设置。合并漏掉的执行并防止任务重叠。
SCHEDULER_MISFIRE_GRACE_SECONDS=30

# ARP/端点采集调度。ARP 每轮最多处理指定数量的设备，0 表示不限制。
ARP_SWEEP_INTERVAL_SECONDS=600
ARP_MAX_DEVICES_PER_SWEEP=500
ENDPOINT_FACT_INTERVAL_SECONDS=1800
ROUTE_SWEEP_INTERVAL_SECONDS=300
ARP_WORKERS_PER_PROCESS=2
ARP_GLOBAL_WORKER_SLOTS=20
ARP_TASK_LEASE_SECONDS=900
ARP_TASK_POLL_SECONDS=1

# 网络设备采集预算（每个后端进程独立限额）
# SSH/CLI 全局最大并发数与单台设备并发限制
NETWORK_SSH_GLOBAL_CONCURRENCY=20
NETWORK_SSH_PER_DEVICE_CONCURRENCY=1
# 拓扑发现的设备级并发；同一设备仍受单设备 SSH 限制保护
TOPOLOGY_DISCOVERY_DEVICE_CONCURRENCY=6
# 拓扑发现运行租约与失败重试上限
TOPOLOGY_DISCOVERY_LEASE_SECONDS=90
TOPOLOGY_DISCOVERY_MAX_ATTEMPTS=2
# SNMP 请求与连通性探测拥有独立的预算配额
NETWORK_SNMP_GLOBAL_CONCURRENCY=30
NETWORK_PROBE_GLOBAL_CONCURRENCY=50
NETWORK_ACCESS_ACQUIRE_TIMEOUT=120
# SSH 复用连接池生命周期（秒 / 单个进程最大空闲连接数）
NETWORK_POOL_IDLE_SECONDS=300
NETWORK_POOL_MAX_SIZE=100
# 自动巡检总开关触发器：每日 02:30 和 14:30 执行
INSPECTION_MASTER_CRON="30 2,14 * * *"
# 配置备份工作线程并发数（备份周期可在 UI 中另行配置）
BACKUP_CONCURRENCY=10
PASSWORD_SYNC_MAX_WORKERS=5
PASSWORD_SYNC_DEVICE_TIMEOUT_SECONDS=240
PASSWORD_SYNC_CONNECT_TIMEOUT_SECONDS=20
PASSWORD_SYNC_COMMAND_READ_TIMEOUT_SECONDS=60
PASSWORD_SYNC_RETRY_LIMIT=1

# Docker Nginx 备用证书名称（域名或服务器 IP）。
# 当 nginx/ssl/netops.crt 和 netops.key 缺失时，Docker 将以此名称生成自签名证书。
# 生产环境建议替换为受信的 CA 证书。
TLS_COMMON_NAME=replace-with-your-server-host
