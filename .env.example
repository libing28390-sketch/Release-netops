# 数据库配置
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
POSTGRES_DB=netops
# 对于 Ubuntu/物理机部署，DATABASE_URL 使用 localhost。
# 对于 Docker Compose，将 localhost 改回 db。
DATABASE_URL=postgresql://postgres:replace-with-a-local-postgres-password@127.0.0.1:5432/netops

# Redis / Celery 队列配置
REDIS_URL=redis://redis:6379/0

# 应用基础配置
# 生产环境建议生成随机密钥
# Docker Compose 会将本文件作为 netops 服务的运行时环境文件加载；
# Compose 中明确声明的 Docker 内部地址和生产环境标识会覆盖本文件对应值。
TZ=Asia/Shanghai
SECRET_KEY=replace-with-a-very-secret-key
# 32位设备凭据加密密钥
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-32-char-random-secret-key
ENVIRONMENT=production
LOG_LEVEL=INFO
# The Windows/local dev launcher disables automatic alert/channel dispatch by
# default so existing database webhooks are not contacted during startup.
# Set explicitly to 1 only for an intentional local notification test.
# NEXORA_AUTOMATIC_NOTIFICATIONS_ENABLED=1
# Backend file-log safety limits. The active file is 10 MiB and five
# compressed backups are retained; Docker stdout/stderr has its own limit.
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5
REQUEST_BODY_MAX_BYTES=157286400
SESSION_TTL_SECONDS=7200
PLAYBOOK_RAW_OUTPUT_RETENTION_DAYS=30
LOG_SLOW_REQUEST_MS=500

# ── AI Provider / Security Gateway / Embedding ──────────────────────────────
# External AI is opt-in.  Provider API keys are entered through the encrypted
# Provider UI or injected by a secret manager; never place a real key here.
# AI 功能总开关：1=启用 AI 功能，0=禁用 AI 功能。
AI_ENABLED=0
# 外部 AI 出口开关：1=允许请求发送到 DeepSeek 等外部 Provider，0=禁止外发。
EXTERNAL_AI_ENABLED=0
# AI 紧急熔断开关：1=立即阻断所有 AI 外部调用，0=按正常安全策略执行。
AI_KILL_SWITCH=0
# AI 临时测试模式在 /ai/security 页面由管理员按时长开启，最多 15 分钟；不需要在此配置。
AI_SECURITY_VAULT_TTL_SECONDS=3600
AI_MAX_PAYLOAD_BYTES=256000
# Provider 类型白名单：只有列出的 Provider 类型可以通过 AI 安全网关调用。
AI_PROVIDER_ALLOWLIST=deepseek,openai,openai_compatible,azure_openai,ollama,local,qwen
AI_DEBUG_PAYLOAD=0
AI_OUTBOUND_PROXY_URL=
AI_PROVIDER_MAX_CONCURRENCY=8
AI_TENANT_MAX_CONCURRENCY=4
AI_USER_MAX_CONCURRENCY=2
AI_CONCURRENCY_ACQUIRE_TIMEOUT_SECONDS=10
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_COOLDOWN_SECONDS=30
AI_HEALTH_BACKOFF_SECONDS=30
AI_DAILY_BUDGET_USD=0

# Embedding is local/deterministic by default.  Set mode=disabled only when
# the deployment intentionally blocks embedding; dimensions must match the
# PostgreSQL vector contract before any index rebuild is approved.
AI_EMBEDDING_MODE=local
AI_EMBEDDING_DIMENSIONS=1536
AI_RETRIEVAL_CACHE_ENABLED=0
AI_RETRIEVAL_TRGM_THRESHOLD=0.35
# Configuration-scope guard: broad or ambiguous configuration requests first
# ask for feature/platform scope and do not expose KB document bodies.
AI_CONFIG_CLARIFICATION_ENABLED=1
AI_CONFIG_CLARIFICATION_ROLLOUT_PERCENT=100

# ── AI/RAG optional sidecars and observability ─────────────────────────────
# Keep the legacy path as the safe default.  Shadow/active require a target
# environment approval, a ready sidecar, and a rollback rehearsal.
AI_RERANKER_MODE=legacy
AI_RERANKER_ENDPOINT=http://127.0.0.1:8004/v1/rerank
AI_RERANKER_TIMEOUT_MS=300
AI_RERANKER_ALLOWED_HOSTS=
AI_RERANKER_WORKERS=4
AI_RERANKER_QUEUE_SIZE=8
AI_RETRIEVAL_CANDIDATE_POOL_SIZE=30

# Parser sidecar is opt-in; active is normalized to docling by the adapter.
AI_PARSER_MODE=legacy
AI_DOCUMENT_PARSER_MODE=legacy
AI_DOCLING_BASE_URL=
AI_DOCLING_ALLOWED_HOSTS=
AI_DOCLING_TIMEOUT_SECONDS=10
AI_DOCLING_MAX_PAGES=50
AI_DOCLING_MAX_RESPONSE_BYTES=2000000
AI_DOCLING_OCR=0
AI_DOCLING_SHADOW_TIMEOUT_SECONDS=0.20
AI_DOCLING_SHADOW_WORKERS=2
AI_DOCLING_SHADOW_QUEUE_SIZE=4

# Metadata-only observability is opt-in.  AI_HASH_SALT and any transport
# credentials must come from a Secret Manager; never add them to this file.
AI_OBSERVABILITY_MODE=off
LANGFUSE_METADATA_ENDPOINT=http://127.0.0.1:3000/api/public/ingestion
LANGFUSE_ALLOWED_HOSTS=
LANGFUSE_TIMEOUT_SECONDS=2

# ── Knowledge Engine / network safety settings ─────────────────────────────
NETWORK_WRITE_ENABLED=0
PRODUCTION_CREDENTIALS_ALLOWED=0

# Test/evaluation-only values.  Production should use a secret namespace and
# real credentials from the deployment secret manager, never this file.
AI_GATEWAY_MODE=offline
DATA_CLASSIFICATION=synthetic
DEVICE_CREDENTIAL_SOURCE=fixture

# [可选] 外部配置管理 API（供 GET /api/templates 接口调用）。
# 留空则默认使用 PostgreSQL 存储的本地模板库。
CONFIG_MANAGEMENT_URL=
CONFIG_MANAGEMENT_TIMEOUT_SECONDS=1

# SNMP MIB 本地上传。仅 Operator/Administrator 可调用上传接口。
# ZIP 内支持 .mib、.my、.txt、.asn 文件；以下限制用于防止压缩包耗尽内存。
SNMP_MIB_MANUAL_UPLOAD_ENABLED=1
SNMP_MIB_UPLOAD_MAX_BYTES=52428800
SNMP_MIB_UPLOAD_MAX_FILES=1000
SNMP_MIB_UPLOAD_MAX_UNCOMPRESSED_BYTES=262144000

# PostgreSQL 数据库连接池安全设置。限制溢出连接数，防止突发流量耗尽数据库会话和文件描述符。
DB_POOL_SIZE=16
DB_POOL_OVERFLOW_MAX=4
DB_POOL_ACQUIRE_TIMEOUT_SECONDS=10

# 针对高频访问的 GET /api/templates 接口的短暂读取缓存。
TEMPLATES_CACHE_TTL_SECONDS=2

# Dashboard read projections. These are process-local short caches; mutations
# invalidate their namespace immediately. Set to 0 to disable a cache.
READ_CACHE_TOPOLOGY_SECONDS=10
READ_CACHE_PLAYBOOKS_SECONDS=5
READ_CACHE_SCHEDULED_JOBS_SECONDS=5
READ_CACHE_RACKS_SECONDS=10
READ_CACHE_REFERENCES_SECONDS=30

# Keep legacy filename/catalog consumers explicit during staged migration.
# Set both to 0 only after the migration preview is clean and all devices are
# bound to a published platform Release.
LEGACY_TEXTFSM_FILE_FALLBACK_ENABLED=1
LEGACY_COMMAND_CATALOG_ENABLED=1

# 定时任务调度器安全设置。合并漏掉的执行并防止任务重叠。
SCHEDULER_MISFIRE_GRACE_SECONDS=30

# ARP/端点采集调度。ARP 每轮最多处理指定数量的设备，0 表示不限制。
ARP_SWEEP_INTERVAL_SECONDS=600
ARP_MAX_DEVICES_PER_SWEEP=500
ENDPOINT_FACT_INTERVAL_SECONDS=1800
ROUTE_SWEEP_INTERVAL_SECONDS=300
ARP_WORKERS_PER_PROCESS=2
ARP_GLOBAL_WORKER_SLOTS=20
ARP_TASK_LEASE_SECONDS=900
ARP_TASK_POLL_SECONDS=1

# 网络设备采集预算（每个后端进程独立限额）
# SSH/CLI 全局最大并发数与单台设备并发限制
NETWORK_SSH_GLOBAL_CONCURRENCY=20
NETWORK_SSH_PER_DEVICE_CONCURRENCY=1
# 拓扑发现的设备级并发；同一设备仍受单设备 SSH 限制保护
TOPOLOGY_DISCOVERY_DEVICE_CONCURRENCY=6
# 拓扑发现运行租约与失败重试上限
TOPOLOGY_DISCOVERY_LEASE_SECONDS=90
TOPOLOGY_DISCOVERY_MAX_ATTEMPTS=2
# SNMP 请求与连通性探测拥有独立的预算配额
NETWORK_SNMP_GLOBAL_CONCURRENCY=30
NETWORK_PROBE_GLOBAL_CONCURRENCY=50
NETWORK_ACCESS_ACQUIRE_TIMEOUT=120
# SSH 复用连接池生命周期（秒 / 单个进程最大空闲连接数）
NETWORK_POOL_IDLE_SECONDS=300
NETWORK_POOL_MAX_SIZE=100
# 自动巡检总开关触发器：每日 02:30 和 14:30 执行
INSPECTION_MASTER_CRON="30 2,14 * * *"
# 配置备份工作线程并发数（备份周期可在 UI 中另行配置）
BACKUP_CONCURRENCY=10
PASSWORD_SYNC_MAX_WORKERS=5
PASSWORD_SYNC_DEVICE_TIMEOUT_SECONDS=240
PASSWORD_SYNC_CONNECT_TIMEOUT_SECONDS=20
PASSWORD_SYNC_COMMAND_READ_TIMEOUT_SECONDS=60
PASSWORD_SYNC_RETRY_LIMIT=1

# Docker Nginx 备用证书名称（域名或服务器 IP）。
# 当 nginx/ssl/netops.crt 和 netops.key 缺失时，Docker 将以此名称生成自签名证书。
# 生产环境建议替换为受信的 CA 证书。
TLS_COMMON_NAME=localhost

# ── 变更单功能开关 ──────────────────────────
# 阶段 2：强制使用模板（集群 1.1 修复）
# 设为 1 时，非草稿状态的变更单必须包含基于场景的命令模板。
# 默认值：0（关闭）—— 允许阶段 1 的修复独立发布。
# FEATURE_TEMPLATE_REQUIRED=0

# 阶段 2：强制控制表（集群 1.2 修复）
# 设为 1 时，初审（initial_review）阶段必须填写控制表字段，且进入实施阶段（implementing）前需至少包含 1 个附件。
# 默认值：0（关闭）
# FEATURE_CONTROL_SHEET=0

# 前端：在 Vite 构建中镜像上述开关
# 本地开发前端默认端口；如有需要可通过 VITE_PORT 显式覆盖。
VITE_PORT=5400
# 设为 0 以在创建/编辑向导中禁用控制表步骤。
# 默认值：启用（任何非 '0' 的值）
VITE_FEATURE_CONTROL_SHEET=1

# ── 互联网出口探测公网 IP 设置 ──────────────────────────
# [可选] 互联网出口期望的公网静态IP。支持配置单个IP、多个逗号分隔的IP或CIDR网段（如 202.96.128.8,210.22.84.5 或 202.96.128.0/29）。若配置且真实获取的出口IP与此不符，系统将产生状态降级告警。
# OUTBOUND_PROBE_EXPECTED_EGRESS_IP=

# [可选] 离线/内网环境静态Override公网IP。配置后将直接跳过外网HTTP检测，直接将此IP作为当前公网IP返回（用于完全隔离的生产网络）。
# OUTBOUND_PROBE_STATIC_EGRESS_IP=

# [可选] 出口公网IP不匹配时的告警级别。可选值：info, warning, critical。默认值为 warning。
# OUTBOUND_PROBE_EGRESS_IP_MISMATCH_SEVERITY=warning

# [可选] 出口公网IP不匹配时是否影响总体的互联网出口健康状态（如果设为 false，只生成事件，不改变总体健康状态）。默认值为 true。
# OUTBOUND_PROBE_EGRESS_IP_MISMATCH_AFFECT_HEALTH=true
