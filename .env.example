# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=netops
# For Ubuntu/bare-metal deploy, DATABASE_URL uses localhost.
# For Docker Compose, change localhost back to db.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/netops

# Redis / Celery Settings
REDIS_URL=redis://redis:6379/0

# App Settings
# Generate a random secret for production
SECRET_KEY=replace-with-a-very-secret-key
# 32-character encryption key for device credentials
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-32-char-random-secret-key
ENVIRONMENT=production

# Optional external configuration-management API used by GET /api/templates.
# Leave empty for the normal local PostgreSQL-backed template store.
CONFIG_MANAGEMENT_URL=
CONFIG_MANAGEMENT_TIMEOUT_SECONDS=1

# PostgreSQL pool safety. Overflow connections are bounded to prevent a
# traffic burst from exhausting database sessions and file descriptors.
DB_POOL_SIZE=16
DB_POOL_OVERFLOW_MAX=4
DB_POOL_ACQUIRE_TIMEOUT_SECONDS=10

# Short read cache for the high-traffic GET /api/templates endpoint.
TEMPLATES_CACHE_TTL_SECONDS=2

# Scheduler safety. Coalesces missed runs and prevents overlapping executions.
SCHEDULER_MISFIRE_GRACE_SECONDS=30

# Network collection budgets (per backend process)
# SSH/CLI total and per-device concurrency
NETWORK_SSH_GLOBAL_CONCURRENCY=20
NETWORK_SSH_PER_DEVICE_CONCURRENCY=1
# SNMP requests and reachability probes are separate budgets
NETWORK_SNMP_GLOBAL_CONCURRENCY=30
NETWORK_PROBE_GLOBAL_CONCURRENCY=50
NETWORK_ACCESS_ACQUIRE_TIMEOUT=120
# Reusable SSH pool lifecycle (seconds / process-wide entries)
NETWORK_POOL_IDLE_SECONDS=300
NETWORK_POOL_MAX_SIZE=100
# Master inspection trigger: twice daily at 02:30 and 14:30
INSPECTION_MASTER_CRON=30 2,14 * * *
# Config backup worker concurrency (backup schedule remains configurable in UI)
BACKUP_CONCURRENCY=10

# Docker Nginx fallback certificate name (domain or server IP).
# When nginx/ssl/netops.crt and netops.key are absent, Docker generates a
# self-signed certificate for this name. Replace it with a trusted certificate
# for production access.
TLS_COMMON_NAME=localhost

# ── Change Order Feature Flags (Task 19.1) ──────────────────────────
# Stage 2: Template enforcement (cluster 1.1 fix)
# Set to 1 to require scenario-based command templates for non-draft orders.
# Default: 0 (OFF) — allows Stage 1 fixes to ship independently.
# FEATURE_TEMPLATE_REQUIRED=0

# Stage 2: Control sheet enforcement (cluster 1.2 fix)
# Set to 1 to require control sheet fields at initial_review and
# at least 1 attachment before entering implementing.
# Default: 0 (OFF)
FEATURE_CONTROL_SHEET=0

# Frontend: mirror the above flags in Vite build
# Set to 0 to disable the control-sheet UI step in the create/edit wizard.
# Default: enabled (any value other than '0')
VITE_FEATURE_CONTROL_SHEET=1
