# Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=netops
# For Ubuntu/bare-metal deploy, DATABASE_URL uses localhost.
# For Docker Compose, change localhost back to db.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/netops

# Redis / Celery Settings
REDIS_URL=redis://redis:6379/0

# App Settings
# Generate a random secret for production
SECRET_KEY=replace-with-a-very-secret-key
# 32-character encryption key for device credentials
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-32-char-random-secret-key
ENVIRONMENT=production

# ── Change Order Feature Flags (Task 19.1) ──────────────────────────
# Stage 2: Template enforcement (cluster 1.1 fix)
# Set to 1 to require scenario-based command templates for non-draft orders.
# Default: 0 (OFF) — allows Stage 1 fixes to ship independently.
# FEATURE_TEMPLATE_REQUIRED=0

# Stage 2: Control sheet enforcement (cluster 1.2 fix)
# Set to 1 to require control sheet fields at initial_review and
# at least 1 attachment before entering implementing.
# Default: 0 (OFF)
FEATURE_CONTROL_SHEET=0

# Frontend: mirror the above flags in Vite build
# Set to 0 to disable the control-sheet UI step in the create/edit wizard.
# Default: enabled (any value other than '0')
VITE_FEATURE_CONTROL_SHEET=1
