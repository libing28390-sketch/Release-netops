# ─────────────────────────────────────────────────────────────────────
#  NetOps Automation — environment template
#  Copy this file to `.env` and replace every `__CHANGE_ME__*` value
#  before starting the service in production.
#
#  Quick generation (Linux / macOS / WSL):
#    SECRET_KEY               =>  openssl rand -hex 32
#    CREDENTIAL_ENCRYPTION_KEY=>  openssl rand -hex 32
#    POSTGRES_PASSWORD        =>  openssl rand -hex 16
#
#  The bundled `deploy-ubuntu.sh` does this automatically when it
#  creates a fresh `.env`; this file is the manual reference.
# ─────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────
POSTGRES_USER=netops
POSTGRES_PASSWORD=__CHANGE_ME__POSTGRES_PASSWORD
POSTGRES_DB=netops
# For Ubuntu/bare-metal deploy, DATABASE_URL uses `localhost`.
# For Docker Compose, change `localhost` back to `db`.
DATABASE_URL=postgresql://netops:__CHANGE_ME__POSTGRES_PASSWORD@localhost:5432/netops

# ─── Redis / Celery ──────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Application secrets ─────────────────────────────────────────────
# Used by FastAPI for any signed token / session derivation.
# Generate with:  openssl rand -hex 32
SECRET_KEY=__CHANGE_ME__SECRET_KEY

# Master key used to encrypt every device password / enable secret in
# the DB. Once the system is running you MUST NOT rotate this without
# re-encrypting existing rows — losing it = losing every stored credential.
# Generate with:  openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=__CHANGE_ME__CREDENTIAL_ENCRYPTION_KEY

ENVIRONMENT=production

# ─── Change Order feature flags (Task 19.1) ──────────────────────────
# Stage 2: Template enforcement (cluster 1.1 fix)
# Set to 1 to require scenario-based command templates for non-draft orders.
# Default: 0 (OFF) — allows Stage 1 fixes to ship independently.
FEATURE_TEMPLATE_REQUIRED=0

# Stage 2: Control sheet enforcement (cluster 1.2 fix)
# Set to 1 to require control sheet fields at initial_review and
# at least 1 attachment before entering implementing.
# Default: 0 (OFF)
FEATURE_CONTROL_SHEET=0

# Frontend: mirror the above flags in Vite build.
# Set to 0 to disable the control-sheet UI step in the create/edit wizard.
# Default: enabled (any value other than '0')
VITE_FEATURE_CONTROL_SHEET=1
