<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <style>
        @page {
            size: A4;
            margin: 1.5cm;
        }
        body {
            font-family: simhei, SimHei, STHeiti, SimSun;
            color: #333;
            line-height: 1.6;
            font-size: 10pt;
        }
        h1 { color: #00bceb; text-align: center; font-size: 22pt; margin-bottom: 20pt; font-family: simhei; font-weight: bold; }
        h2 { color: #00bceb; border-bottom: 2px solid #00bceb; padding-bottom: 4pt; margin-top: 18pt; margin-bottom: 10pt; font-size: 14pt; font-family: simhei; font-weight: bold; }
        .summary-box {
            background-color: #f0faff;
            border: 1px solid #cceeff;
            padding: 14pt 16pt;
            margin-bottom: 20pt;
            border-radius: 4px;
        }
        .summary-grid {
            width: 100%;
            margin-bottom: 10pt;
        }
        .summary-label {
            font-weight: bold;
            color: #555;
            width: 18%;
        }
        .summary-val {
            width: 32%;
            color: #111;
        }
        .status-count-grid {
            width: 100%;
            margin: 8pt 0 4pt;
        }
        .status-count-grid td {
            text-align: center;
            padding: 6pt 3pt;
            font-size: 8.5pt;
            background-color: #fff;
        }
        .count-value {
            display: block;
            margin-top: 3pt;
            font-size: 14pt;
            font-weight: bold;
            color: #111;
        }
        .count-healthy .count-value { color: #388e3c; }
        .count-warning .count-value { color: #f57c00; }
        .count-critical .count-value { color: #d32f2f; }
        .count-partial .count-value { color: #2563eb; }
        .count-unknown .count-value { color: #666; }
        .summary-note { margin: 5pt 0 0; color: #666; font-size: 8.5pt; }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 15pt;
            table-layout: fixed;
            word-wrap: break-word;
        }
        th {
            background-color: #00bceb;
            color: white;
            font-weight: bold;
            text-align: left;
            padding: 8pt 6pt;
            border: 1px solid #00bceb;
            font-size: 9.5pt;
            font-family: simhei;
            word-break: break-all;
        }
        td {
            padding: 8pt 6pt;
            border: 1px solid #e0e0e0;
            vertical-align: middle;
            font-size: 9pt;
            font-family: simhei;
            word-break: break-all;
        }
        .status-critical { color: #d32f2f; font-weight: bold; }
        .status-warning { color: #f57c00; font-weight: bold; }
        .status-healthy { color: #388e3c; font-weight: bold; }
        .status-partial { color: #2563eb; font-weight: bold; }
        .status-unknown, .status-unchecked, .status-not_collected, .status-unavailable,
        .status-skipped, .status-pending, .status-queued, .status-running {
            color: #666; font-weight: bold;
        }
        
        .footer {
            margin-top: 40pt;
            text-align: center;
            font-size: 8.5pt;
            color: #888;
            border-top: 1px solid #eee;
            padding-top: 12pt;
            font-family: simhei;
        }
    </style>
</head>
<body>
    {% if report_type == 'playbook' %}
        <h1>{{ system_name }} NetOps 自动化执行报告</h1>
    {% else %}
        <h1>{{ system_name }} NetOps 巡检报告</h1>
    {% endif %}

    <div class="summary-box">
        <table class="summary-grid">
            <tr>
                <td class="summary-label">任务名称:</td>
                <td class="summary-val" colspan="3">{{ run_info.name or run_info.scenario_name or '巡检任务' }}</td>
            </tr>
            <tr>
                <td class="summary-label">巡检时间:</td>
                <td class="summary-val" colspan="3">{{ inspection_time }}</td>
            </tr>
            <tr>
                <td class="summary-label">生成时间:</td>
                <td class="summary-val">{{ generated_at }}</td>
                <td class="summary-label">客户名称:</td>
                <td class="summary-val">{{ customer_name or '-' }}</td>
            </tr>
            <tr>
                <td class="summary-label">负责工程师:</td>
                <td class="summary-val" colspan="3">{{ engineer_name or '-' }}</td>
            </tr>
        </table>
        <table class="status-count-grid">
            <tr>
                <td>设备总数<span class="count-value">{{ total_devices }}</span></td>
                <td class="count-healthy">正常<span class="count-value">{{ healthy_count }}</span></td>
                <td class="count-warning">告警<span class="count-value">{{ warning_count }}</span></td>
                <td class="count-critical">异常<span class="count-value">{{ critical_count }}</span></td>
                <td class="count-partial">部分采集<span class="count-value">{{ partial_count }}</span></td>
                <td class="count-unknown">未采集/未知<span class="count-value">{{ uncollected_device_count }}</span></td>
            </tr>
        </table>
        <p class="summary-note">未采集检查项：{{ unchecked_count }} 项。未采集或未知设备不计入正常或异常。</p>
    </div>

    {% if report_type == 'playbook' %}
        <h2>一、 作业异常摘要</h2>
        {% if abnormal_devices %}
        <table>
            <thead>
                <tr>
                    <th width="20%">设备名称</th>
                    <th width="18%">管理 IP</th>
                    <th width="12%">状态</th>
                    <th width="22%">异常检查项</th>
                    <th width="28%">异常说明</th>
                </tr>
            </thead>
            <tbody>
                {% for dev in abnormal_devices %}
                <tr>
                    <td>{{ dev.hostname }}</td>
                    <td>{{ dev.ip_address }}</td>
                    <td class="status-{{ dev.health_status }}">{{ dev.status_label }}</td>
                    <td>{{ dev.finding_item }}</td>
                    <td>{{ dev.top_finding or '执行过程发现异常' }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <p style="color:#666; margin-bottom: 20pt;">所有设备均成功完成既定阶段作业任务，未捕获运行异常。</p>
        {% endif %}

        {% if unchecked_items %}
        <h2>二、 未采集项</h2>
        <table>
            <thead><tr><th width="25%">设备名称</th><th width="22%">管理 IP</th><th width="23%">检查项</th><th width="30%">未采集说明</th></tr></thead>
            <tbody>
                {% for device in unchecked_items %}
                    {% for item in device['items'] %}
                    <tr><td>{{ device.hostname }}</td><td>{{ device.ip_address }}</td><td>{{ item.item }}</td><td>{{ item.detail or '未取得有效数据' }}</td></tr>
                    {% endfor %}
                {% endfor %}
            </tbody>
        </table>
        {% endif %}

        <h2>三、 执行结果详情表</h2>
        <table>
            <thead>
                <tr>
                    <th width="30%">设备名称</th>
                    <th width="30%">管理 IP 地址</th>
                    <th width="20%">状态</th>
                    <th width="20%">耗时</th>
                </tr>
            </thead>
            <tbody>
                {% for dev in all_devices %}
                <tr>
                    <td>{{ dev.hostname }}</td>
                    <td>{{ dev.ip_address }}</td>
                    <td class="status-{{ dev.health_status }}">{{ dev.status_label }}</td>
                    <td>{% if dev.duration_ms is not none %}{{ dev.duration_ms }} 毫秒{% else %}—{% endif %}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>

    {% else %}
        <h2>一、 异常设备处理摘要</h2>
        {% if abnormal_devices %}
        <table>
            <thead>
                <tr>
                    <th width="18%">设备名称</th>
                    <th width="17%">IP 地址</th>
                    <th width="12%">状态</th>
                    <th width="27%">最重要问题</th>
                    <th width="26%">建议处理</th>
                </tr>
            </thead>
            <tbody>
                {% for dev in abnormal_devices %}
                <tr>
                    <td>{{ dev.hostname }}</td>
                    <td>{{ dev.ip_address }}</td>
                    <td class="status-{{ dev.health_status }}">{{ dev.status_label }}</td>
                    <td>{{ dev.top_finding }}</td>
                    <td>{{ dev.suggestion }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        {% if partial_count or uncollected_device_count %}
        <p style="color:#666; margin-bottom: 20pt;">未发现已确认的告警或异常设备；部分采集 {{ partial_count }} 台、未采集/未知 {{ uncollected_device_count }} 台，请先核实采集范围。</p>
        {% else %}
        <p style="color:#666; margin-bottom: 20pt;">未发现告警或异常设备。</p>
        {% endif %}
        {% endif %}

        <h2>二、 关联风险分析</h2>
        {% if all_risks %}
        <table>
            <thead>
                <tr>
                    <th width="20%">设备</th>
                    <th width="30%">风险规则</th>
                    <th width="15%">严重程度</th>
                    <th width="35%">详细描述</th>
                </tr>
            </thead>
            <tbody>
                {% for risk in all_risks %}
                <tr>
                    <td>{{ risk.device }}</td>
                    <td>{{ risk.rule_name }}</td>
                    <td class="status-{{ risk.severity }}">{{ risk.severity_label }}</td>
                    <td>{{ risk.description }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <p style="color:#666; margin-bottom: 20pt;">未检测到复合关联网络风险。</p>
        {% endif %}

        <h2>三、 整改建议</h2>
        {% if suggestions %}
        <table>
            <thead>
                <tr>
                    <th width="20%">设备</th>
                    <th width="20%">指标</th>
                    <th width="30%">诊断结论</th>
                    <th width="30%">整改建议</th>
                </tr>
            </thead>
            <tbody>
                {% for sug in suggestions %}
                <tr>
                    <td>{{ sug.hostname }}</td>
                    <td>{{ sug.metric }}</td>
                    <td>{{ sug.conclusion }}</td>
                    <td>{{ sug.suggestion }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <p style="color:#666; margin-bottom: 20pt;">所有网络指标均在健康基线内，暂无整改建议。</p>
        {% endif %}

        <h2>四、 资产汇总列表</h2>
        <table>
            <thead>
                <tr>
                    <th width="25%">设备名称</th>
                    <th width="25%">管理 IP 地址</th>
                    <th width="20%">硬件平台</th>
                    <th width="15%">状态</th>
                    <th width="15%">合规状态</th>
                </tr>
            </thead>
            <tbody>
                {% for dev in all_devices %}
                <tr>
                    <td>{{ dev.hostname }}</td>
                    <td>{{ dev.ip_address }}</td>
                    <td>{{ dev.platform or '-' }}</td>
                    <td class="status-{{ dev.health_status }}">{{ dev.status_label }}</td>
                    <td>{{ dev.compliance_status }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <div class="footer">
        {{ system_name }} NetOps 自动化系统。智能网络运维系统自动生成报告。
    </div>
</body>
</html>
