<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% if report_type == 'playbook' %}{{ system_name }} 自动化巡检报告 · {{ job_name }}{% else %}{{ system_name }} 网络巡检报告{% endif %} - {{ run_info.get('started_at', '')[:10] }}</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #fff; color: #111827; line-height: 1.6; padding: 40px; }
.container { max-width: 1200px; margin: 0 auto; }
.header { text-align: center; padding: 28px 0 24px; border-bottom: 1px solid #dbe3ec; margin-bottom: 24px; }
.header h1 { font-size: 26px; color: #145b82; margin-bottom: 6px; font-weight: bold; }
.header .subtitle { font-size: 15px; color: #0f172a; font-weight: 600; margin-bottom: 8px; }
.header .meta { color: #475569; font-size: 13px; }
.section { margin-bottom: 32px; }
.section-title { font-size: 17px; color: #145b82; border-left: 4px solid #1684b8; padding-left: 12px; margin-bottom: 14px; font-weight: bold; }
.stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-bottom: 20px; }
.stat-card { background: #f8fafc; border-radius: 10px; padding: 14px; text-align: center; border: 1px solid #dbe3ec; }
.stat-card .value { font-size: 28px; font-weight: bold; }
.stat-card .label { font-size: 12px; color: #475569; margin-top: 4px; }
.ok-banner { background: #f0fdf4; padding: 16px 20px; border-radius: 10px; color: #166534; text-align: center; border: 1px solid #bbf7d0; font-size: 13px; font-weight: 600; }
details.device-detail { border: 1px solid #dbe3ec; border-radius: 10px; margin-bottom: 12px; overflow: hidden; background: #fff; }
details.device-detail > summary { padding: 12px 16px; background: #f8fafc; cursor: pointer; font-weight: 600; font-size: 13px; color: #0f172a; display: flex; align-items: center; justify-content: space-between; list-style: none; }
details.device-detail > summary::-webkit-details-marker { display: none; }
details.device-detail[open] > summary { border-bottom: 1px solid #e2e8f0; background: #edf4f8; }
.cmd-block { border-top: 1px solid #e2e8f0; }
.cmd-block:first-child { border-top: none; }
.cmd-header { padding: 8px 16px; background: #f8fafc; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 12px; font-weight: 700; color: #145b82; }
.cmd-output { padding: 12px 16px; margin: 0; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 12px; line-height: 1.5; white-space: pre-wrap; word-break: break-all; background: #ffffff; color: #1e293b; max-height: 420px; overflow-y: auto; }
.healthy { color: #15803d; }
.warning { color: #b45309; }
.critical { color: #c62828; }
.partial { color: #2563eb; }
table { width: 100%; border-collapse: collapse; margin-bottom: 16px; table-layout: fixed; word-wrap: break-word; }
th { background: #edf4f8; color: #164e63; padding: 11px 12px; text-align: left; font-size: 13px; font-weight: bold; }
td { padding: 11px 12px; border-bottom: 1px solid #e2e8f0; font-size: 13px; vertical-align: top; color: #111827; }
tr:hover { background: #f8fafc; }
.badge { display: inline-block; padding: 4px 10px; border-radius: 6px; font-size: 11px; font-weight: bold; }
.badge-critical { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; }
.badge-warning { background: #fffbeb; color: #a16207; border: 1px solid #fde68a; }
.badge-healthy { background: #f0fdf4; color: #15803d; border: 1px solid #bbf7d0; }
.badge-partial { background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; }
.risk-card { background: #fff; border: 1px solid #fecaca; border-radius: 8px; padding: 16px; margin-bottom: 12px; }
.risk-card h4 { color: #b91c1c; margin-bottom: 8px; }
.footer { text-align: center; color: #64748b; font-size: 12px; padding-top: 24px; border-top: 1px solid #dbe3ec; margin-top: 32px; }
</style>
</head>
<body>
<div class="container">
  <!-- 1. 报告头部 -->
  <div class="header">
    {% if report_type == 'playbook' %}
        <h1>{{ system_name }} 自动化巡检报告</h1>
        {% if job_name %}<div class="subtitle">作业名称：{{ job_name }}</div>{% endif %}
    {% else %}
        <h1>{{ system_name }} 网络巡检报告</h1>
    {% endif %}
    <div class="meta">
      {% if customer_name %}客户: {{ customer_name }} | {% endif %}
      {% if engineer_name %}工程师: {{ engineer_name }} | {% endif %}
      执行时间: {{ started_at_display }} |
      设备总数: {{ run_info.get('total_devices', total_devices) }}
    </div>
  </div>

  <!-- 2. 摘要与统计 -->
  <div class="section">
    <h2 class="section-title">{% if report_type == 'playbook' %}作业执行摘要{% else %}巡检摘要{% endif %}</h2>
    <div class="stats-grid">
      <div class="stat-card"><div class="value">{{ total_devices }}</div><div class="label">设备总数</div></div>
      <div class="stat-card"><div class="value healthy">{{ healthy_count }}</div><div class="label">正常设备</div></div>
      <div class="stat-card"><div class="value warning">{{ warning_count }}</div><div class="label">告警设备</div></div>
      <div class="stat-card"><div class="value critical">{{ critical_count }}</div><div class="label">异常设备</div></div>
      <div class="stat-card"><div class="value partial">{{ partial_count }}</div><div class="label">部分采集设备</div></div>
      <div class="stat-card"><div class="value partial">{{ unchecked_count }}</div><div class="label">未采集检查项</div></div>
    </div>
  </div>

  {% if report_type == 'playbook' %}
      <!-- Playbook 专属执行异常概览 -->
      <div class="section">
        <h2 class="section-title">作业异常详情</h2>
        {% if abnormal_devices %}
        <table>
          <thead><tr><th width="22%">设备名称</th><th width="20%">管理 IP</th><th width="13%">状态</th><th width="20%">异常检查项</th><th width="25%">异常说明</th></tr></thead>
          <tbody>
          {% for dev in abnormal_devices %}
          <tr>
            <td>{{ dev.hostname }}</td>
            <td>{{ dev.ip_address }}</td>
            <td><span class="badge badge-{{ dev.health_status }}">{{ dev.status_label }}</span></td>
            <td>{{ dev.finding_item }}</td>
            <td>{{ dev.top_finding or '执行过程出现异常' }}</td>
          </tr>
          {% endfor %}
          </tbody>
        </table>
        {% else %}
        <div class="ok-banner">
          ✅ 所有覆盖设备均已成功完成既定自动化巡检任务，未捕获异常。
        </div>
        {% endif %}
      </div>

      {% if unchecked_items %}
      <div class="section">
        <h2 class="section-title">未采集项</h2>
        <table>
          <thead><tr><th width="25%">设备名称</th><th width="22%">管理 IP</th><th width="23%">检查项</th><th width="30%">未采集说明</th></tr></thead>
          <tbody>
          {% for device in unchecked_items %}
            {% for item in device['items'] %}
            <tr><td>{{ device.hostname }}</td><td>{{ device.ip_address }}</td><td>{{ item.item }}</td><td>{{ item.detail or '未取得有效数据' }}</td></tr>
            {% endfor %}
          {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}

      <!-- Playbook 专属执行明细列表 -->
      <div class="section">
        <h2 class="section-title">作业执行明细表</h2>
        <table>
          <thead>
            <tr>
              <th width="16%">设备名称</th>
              <th width="15%">管理 IP</th>
              <th width="13%">硬件平台</th>
              <th width="32%">核心巡检指标摘要</th>
              <th width="10%">状态</th>
              <th width="14%">耗时 / 命令</th>
            </tr>
          </thead>
          <tbody>
          {% for dev in all_devices %}
          <tr>
            <td><strong>{{ dev.hostname }}</strong></td>
            <td><code>{{ dev.ip_address }}</code></td>
            <td>{{ dev.platform or '-' }}</td>
            <td>{{ dev.key_metrics or '已完成脚本采集（见下方回显明细）' }}</td>
            <td><span class="badge badge-{{ dev.health_status }}">{{ dev.status_label }}</span></td>
            <td>{% if dev.duration_ms is not none %}{{ dev.duration_ms }} ms{% else %}—{% endif %}{% if dev.command_count %} · {{ dev.command_count }} 项{% endif %}</td>
          </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>

      <!-- 设备命令执行回显明细（可折叠展开） -->
      <div class="section">
        <h2 class="section-title">设备命令执行回显明细（点击设备展开）</h2>
        {% for dev in all_devices %}
        <details class="device-detail"{% if loop.first or dev.health_status in ('critical', 'warning') %} open{% endif %}>
          <summary>
            <span>{{ dev.hostname }}（{{ dev.ip_address }}）{% if dev.key_metrics %} — {{ dev.key_metrics }}{% endif %}</span>
            <span class="badge badge-{{ dev.health_status }}">{{ dev.status_label }}</span>
          </summary>
          {% if dev.command_blocks %}
            {% for blk in dev.command_blocks %}
            <div class="cmd-block">
              <div class="cmd-header">&gt; {{ blk.command }}</div>
              <pre class="cmd-output">{{ blk.output or '（命令执行成功，无回显）' }}</pre>
            </div>
            {% endfor %}
          {% else %}
            <div class="cmd-output">（无详细命令回显）</div>
          {% endif %}
        </details>
        {% endfor %}
      </div>

  {% else %}
      <!-- 3. 关联风险 -->
      {% if all_risks %}
      <div class="section">
        <h2 class="section-title">关联风险预警</h2>
        {% for risk in all_risks %}
        <div class="risk-card">
          <h4>⚠️ {{ risk.rule_name }} ({{ risk.device }})</h4>
          <p>{{ risk.description }}</p>
          <p style="color:#94a3b8; margin-top:8px;">建议: {{ risk.suggestion }}</p>
        </div>
        {% endfor %}
      </div>
      {% endif %}

      <!-- 4. 异常设备列表 -->
      {% if abnormal_devices %}
      <div class="section">
        <h2 class="section-title">异常设备列表</h2>
        <table>
          <thead><tr><th width="25%">设备名称</th><th width="25%">管理 IP</th><th width="15%">状态</th><th width="35%">主要异常</th></tr></thead>
          <tbody>
          {% for dev in abnormal_devices %}
          <tr>
            <td>{{ dev.hostname }}</td>
            <td>{{ dev.ip_address }}</td>
            <td><span class="badge badge-{{ dev.health_status }}">{{ dev.status_label }}</span></td>
            <td>{{ dev.top_finding }}</td>
          </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}

      <!-- 5. 设备指标汇总表 -->
      <div class="section">
        <h2 class="section-title">资产健康指标汇总</h2>
        <table>
          <thead><tr><th width="30%">设备名称</th><th width="25%">管理 IP</th><th width="20%">硬件平台</th><th width="25%">状态</th></tr></thead>
          <tbody>
          {% for dev in all_devices %}
          <tr>
            <td>{{ dev.hostname }}</td>
            <td>{{ dev.ip_address }}</td>
            <td>{{ dev.platform or '-' }}</td>
            <td>{{ dev.status_label }}{% if dev.compliance_status != '未知' %}（{{ dev.compliance_status }}）{% endif %}</td>
          </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>

      <!-- 6. 整改建议 -->
      {% if suggestions %}
      <div class="section">
        <h2 class="section-title">系统整改建议</h2>
        <table>
          <thead><tr><th width="20%">设备</th><th width="20%">异常指标</th><th width="15%">严重度</th><th width="25%">诊断结论</th><th width="20%">整改建议</th></tr></thead>
          <tbody>
          {% for s in suggestions %}
          <tr>
            <td>{{ s.hostname }}</td>
            <td>{{ s.metric }}</td>
            <td><span class="badge badge-{{ s.status }}">{{ s.status_label }}</span></td>
            <td>{{ s.conclusion }}</td>
            <td>{{ s.suggestion }}</td>
          </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}
  {% endif %}

  <div class="footer">
    <p>{{ system_name }} NetOps 智能网络运维系统 | 报告自动生成于: {{ generated_at }}</p>
  </div>
</div>

</body>
</html>
