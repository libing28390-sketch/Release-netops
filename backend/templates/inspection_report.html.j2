<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nexora 网络巡检报告 - {{ run_info.get('started_at', '')[:10] }}</title>
<script src="https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.min.js"></script>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #0a1628; color: #e2e8f0; line-height: 1.6; padding: 40px; }
.container { max-width: 1200px; margin: 0 auto; }
.header { text-align: center; padding: 40px 0; border-bottom: 1px solid #1e3a5f; margin-bottom: 30px; }
.header h1 { font-size: 28px; color: #00bceb; margin-bottom: 8px; }
.header .meta { color: #64748b; font-size: 14px; }
.section { margin-bottom: 30px; }
.section-title { font-size: 18px; color: #00bceb; border-left: 4px solid #00bceb; padding-left: 12px; margin-bottom: 16px; }
.stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px; }
.stat-card { background: #1e293b; border-radius: 12px; padding: 20px; text-align: center; border: 1px solid #334155; }
.stat-card .value { font-size: 32px; font-weight: bold; }
.stat-card .label { font-size: 12px; color: #94a3b8; margin-top: 4px; }
.healthy { color: #10b981; }
.warning { color: #f59e0b; }
.critical { color: #ef4444; }
table { width: 100%; border-collapse: collapse; margin-bottom: 16px; }
th { background: #1e3a5f; color: #00bceb; padding: 10px 12px; text-align: left; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; }
td { padding: 10px 12px; border-bottom: 1px solid #1e293b; font-size: 13px; }
tr:hover { background: #1e293b; }
.badge { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: bold; }
.badge-critical { background: #7f1d1d; color: #fca5a5; }
.badge-warning { background: #78350f; color: #fcd34d; }
.badge-healthy { background: #064e3b; color: #6ee7b7; }
.risk-card { background: #1e293b; border: 1px solid #ef4444; border-radius: 8px; padding: 16px; margin-bottom: 12px; }
.risk-card h4 { color: #ef4444; margin-bottom: 8px; }
#chart-health { width: 100%; height: 300px; }
.footer { text-align: center; color: #475569; font-size: 12px; padding-top: 30px; border-top: 1px solid #1e3a5f; margin-top: 40px; }
</style>
</head>
<body>
<div class="container">
  <!-- 1. 报告头部 -->
  <div class="header">
    <h1>Nexora 网络巡检报告</h1>
    <div class="meta">
      {% if customer_name %}客户: {{ customer_name }} | {% endif %}
      {% if engineer_name %}工程师: {{ engineer_name }} | {% endif %}
      巡检时间: {{ run_info.get('started_at', 'N/A') }} |
      设备总数: {{ run_info.get('total_devices', 0) }}
    </div>
  </div>

  <!-- 2. 巡检摘要 -->
  <div class="section">
    <h2 class="section-title">巡检摘要</h2>
    <div class="stats-grid">
      <div class="stat-card"><div class="value">{{ total_devices }}</div><div class="label">设备总数</div></div>
      <div class="stat-card"><div class="value healthy">{{ healthy_count }}</div><div class="label">健康</div></div>
      <div class="stat-card"><div class="value warning">{{ warning_count }}</div><div class="label">告警</div></div>
      <div class="stat-card"><div class="value critical">{{ critical_count }}</div><div class="label">严重</div></div>
      <div class="stat-card"><div class="value" style="color:#00bceb">{{ avg_score }}</div><div class="label">平均健康评分</div></div>
    </div>
    <div id="chart-health"></div>
  </div>

  <!-- 3. 关联风险 -->
  {% if all_risks %}
  <div class="section">
    <h2 class="section-title">关联风险预警</h2>
    {% for risk in all_risks %}
    <div class="risk-card">
      <h4>⚠️ {{ risk.rule_name }} ({{ risk.device }})</h4>
      <p>{{ risk.description }}</p>
      <p style="color:#94a3b8; margin-top:8px;">建议: {{ risk.suggestion }}</p>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  <!-- 4. 异常设备列表 -->
  {% if abnormal_devices %}
  <div class="section">
    <h2 class="section-title">异常设备列表</h2>
    <table>
      <thead><tr><th>设备名称</th><th>管理 IP</th><th>健康评分</th><th>状态</th><th>主要异常</th></tr></thead>
      <tbody>
      {% for dev in abnormal_devices %}
      <tr>
        <td>{{ dev.hostname }}</td>
        <td>{{ dev.ip_address }}</td>
        <td>{{ dev.health_score }}</td>
        <td><span class="badge badge-{{ dev.health_status }}">{{ dev.health_status }}</span></td>
        <td>{{ dev.top_finding }}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  <!-- 5. 设备指标汇总表 -->
  <div class="section">
    <h2 class="section-title">设备指标汇总</h2>
    <table>
      <thead><tr><th>设备名称</th><th>IP</th><th>平台</th><th>健康评分</th><th>状态</th><th>合规</th></tr></thead>
      <tbody>
      {% for dev in all_devices %}
      <tr>
        <td>{{ dev.hostname }}</td>
        <td>{{ dev.ip_address }}</td>
        <td>{{ dev.platform }}</td>
        <td>{{ dev.health_score }}</td>
        <td><span class="badge badge-{{ dev.health_status }}">{{ dev.health_status }}</span></td>
        <td>{{ dev.compliance_status }}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>

  <!-- 6. 整改建议 -->
  {% if suggestions %}
  <div class="section">
    <h2 class="section-title">整改建议</h2>
    <table>
      <thead><tr><th>设备</th><th>指标</th><th>状态</th><th>结论</th><th>建议</th></tr></thead>
      <tbody>
      {% for s in suggestions %}
      <tr>
        <td>{{ s.hostname }}</td>
        <td>{{ s.metric }}</td>
        <td><span class="badge badge-{{ s.status }}">{{ s.status }}</span></td>
        <td>{{ s.conclusion }}</td>
        <td>{{ s.suggestion }}</td>
      </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  <div class="footer">
    <p>Nexora NetOps 智能巡检系统 | 报告生成时间: {{ generated_at }}</p>
  </div>
</div>

<script>
var chart = echarts.init(document.getElementById('chart-health'));
chart.setOption({
  tooltip: { trigger: 'item' },
  series: [{
    type: 'pie', radius: ['40%', '70%'],
    data: [
      { value: {{ healthy_count }}, name: '健康', itemStyle: { color: '#10b981' } },
      { value: {{ warning_count }}, name: '告警', itemStyle: { color: '#f59e0b' } },
      { value: {{ critical_count }}, name: '严重', itemStyle: { color: '#ef4444' } }
    ],
    label: { color: '#e2e8f0' }
  }]
});
window.addEventListener('resize', () => chart.resize());
</script>
</body>
</html>
