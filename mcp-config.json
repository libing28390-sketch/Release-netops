{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-playwright"],
      "env": {
        "PLAYWRIGHT_SNAPSHOT_DIR": "./.playwright-mcp"
      },
      "description": "Browser automation and snapshot testing"
    },
    "postgres": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres", "postgresql://user:pass@localhost:5432/netops"],
      "description": "Direct PostgreSQL 17 database access and analysis"
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "d:/netsops"],
      "description": "Enhanced file system access for deep analysis"
    },
    "git": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-git"],
      "description": "Advanced version control and history analysis"
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "description": "Integration with GitHub for issue tracking and PR analysis"
    }
  }
}
