    {
      "id": 7,
      "title": "CPU 各状态利用率走势 (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "暂无采集数据",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "none",
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*整机 CPU 利用率.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3B82F6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*用户态.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#22D3EE"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*系统态.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#A78BFA"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*I/O等待.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#F59E0B"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "100 - (avg by (hostname) (rate(node_cpu_seconds_total{job=\"linux_servers\",site_name=~\"$site\",hostname=~\"$device\",mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "{{site_name}} / {{hostname}} 整机 CPU 利用率 (%)",
          "refId": "A"
        },
        {
          "expr": "avg by (hostname) (rate(node_cpu_seconds_total{job=\"linux_servers\",site_name=~\"$site\",hostname=~\"$device\",mode=\"user\"}[5m])) * 100",
          "legendFormat": "{{site_name}} / {{hostname}} 用户态 (user %)",
          "refId": "B"
        },
        {
          "expr": "avg by (hostname) (rate(node_cpu_seconds_total{job=\"linux_servers\",site_name=~\"$site\",hostname=~\"$device\",mode=\"system\"}[5m])) * 100",
          "legendFormat": "{{site_name}} / {{hostname}} 系统态 (system %)",
          "refId": "C"
        },
        {
          "expr": "avg by (hostname) (rate(node_cpu_seconds_total{job=\"linux_servers\",site_name=~\"$site\",hostname=~\"$device\",mode=\"iowait\"}[5m])) * 100",
          "legendFormat": "{{site_name}} / {{hostname}} I/O等待 (iowait %)",
          "refId": "D"
        }
      ]
    },
