    {
      "id": 7,
      "title": "CPU 利用率与平均负载趋势",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "100 - (rate(node_cpu_seconds_total{instance=~\"$device\",mode=\"idle\"}[5m]) * 100)",
          "legendFormat": "{{instance}} CPU利用率 (%)",
          "refId": "A"
        },
        {
          "expr": "node_load1{instance=~\"$device\"}",
          "legendFormat": "{{instance}} 1分钟负载 (Load1)",
          "refId": "B"
        },
        {
          "expr": "node_load5{instance=~\"$device\"}",
          "legendFormat": "{{instance}} 5分钟负载 (Load5)",
          "refId": "C"
        },
        {
          "expr": "node_load15{instance=~\"$device\"}",
          "legendFormat": "{{instance}} 15分钟负载 (Load15)",
          "refId": "D"
        }
      ]
    },
    {
      "id": 8,
      "title": "物理内存与 Swap 空间消耗走势",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
