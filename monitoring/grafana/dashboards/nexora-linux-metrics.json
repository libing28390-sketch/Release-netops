        {
          "expr": "sum by (instance, device) (rate(node_disk_written_bytes_total{instance=~\"$device\",device!~\"loop.*\"}[5m]))",
          "legendFormat": "{{instance}} - {{device}} 写吞吐",
          "refId": "B"
        }
      ]
