      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes{instance=~\"$device\"} / node_memory_MemTotal_bytes{instance=~\"$device\"})) * 100",
          "legendFormat": "{{instance}} 内存利用率 (%)",
          "refId": "A"
        },
        {
          "expr": "node_memory_MemTotal_bytes{instance=~\"$device\"} - node_memory_MemAvailable_bytes{instance=~\"$device\"}",
          "legendFormat": "{{instance}} 内存已用量",
          "refId": "B"
        },
        {
          "expr": "(1 - (node_memory_SwapFree_bytes{instance=~\"$device\"} / node_memory_SwapTotal_bytes{instance=~\"$device\"})) * 100",
          "legendFormat": "{{instance}} Swap 利用率 (%)",
          "refId": "C"
