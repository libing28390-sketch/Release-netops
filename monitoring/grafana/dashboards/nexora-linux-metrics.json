    {
      "id": 10,
      "title": "磁盘读写吞吐速率 (Bytes/s)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "noValue": "数据暂不可用",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
