    {
      "id": 11,
      "title": "主机磁盘空间利用率 Top 10",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "数据暂不可用",
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "数值"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "footer": {
          "show": false
        },
        "enablePagination": true
      },
      "targets": [
        {
          "expr": "topk(10, max by (hostname, mountpoint) ((1 - (node_filesystem_avail_bytes{job=\"linux_servers\",site_name=~\"$site\",hostname=~\"$device\",fstype!~\"tmpfs|iso9660|squashfs\",fstype!=\"\"} / node_filesystem_size_bytes{job=\"linux_servers\",site_name=~\"$site\",hostname=~\"$device\"})) * 100))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "ifIndex": true,
              "asset_id": true,
              "nexora_asset_id": true,
              "nexora_hostname": true,
              "nexora_module": true,
              "nexora_platform": true,
              "nexora_role": true,
              "nexora_site_id": true,
              "nexora_site_name": true,
              "nexora_tenant_id": true,
              "nexora_vendor": true,
              "job": true,
              "tenant_id": true,
              "site_id": true,
              "platform": true,
              "sysName": true,
              "nexora_interface_role": true
            },
            "indexByName": {
              "site_name": 0,
              "hostname": 1,
              "instance": 2,
              "ifName": 3,
              "ifDescr": 4,
              "vendor": 5,
              "role": 6,
              "interface_role": 7,
              "utilization_warn_pct": 8,
              "utilization_high_pct": 9,
              "utilization_critical_pct": 10,
              "Value": 11
            },
            "renameByName": {
              "sysName": "设备名称",
              "hostname": "设备名称",
              "instance": "管理 IP",
              "site_name": "站点",
              "ifName": "接口全称",
              "ifDescr": "接口描述",
              "vendor": "厂商",
              "role": "角色",
              "interface_role": "接口角色",
              "utilization_warn_pct": "预警阈值 (%)",
              "utilization_high_pct": "高位阈值 (%)",
              "utilization_critical_pct": "严重阈值 (%)",
              "Value": "磁盘使用率",
              "mountpoint": "挂载点"
            }
          }
        }
      ]
    },
