        {
          "expr": "node_load15{job=\"linux_servers\",site_name=~\"$site\",hostname=~\"$device\"}",
          "legendFormat": "{{site_name}} / {{hostname}} 15分钟负载 (Load15)",
          "refId": "C"
        },
        {
          "expr": "count by (hostname) (node_cpu_seconds_total{job=\"linux_servers\",site_name=~\"$site\",hostname=~\"$device\",mode=\"idle\"})",
          "legendFormat": "{{site_name}} / {{hostname}} 逻辑 CPU 核心数 (阈值参考)",
          "refId": "D"
