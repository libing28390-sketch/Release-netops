        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (instance, device) (rate(node_disk_read_bytes_total{instance=~\"$device\",device!~\"loop.*\"}[5m]))",
          "legendFormat": "{{instance}} - {{device}} 读吞吐",
          "refId": "A"
