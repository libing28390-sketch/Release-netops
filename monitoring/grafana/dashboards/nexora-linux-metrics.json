    {
      "id": 7,
      "title": "CPU 各状态利用率走势 (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "数据暂不可用",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "none",
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "100 - (avg by (hostname) (rate(node_cpu_seconds_total{job=\"linux_servers\",site_name=~\"$site\",hostname=~\"$device\",mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "{{site_name}} / {{hostname}} 整机 CPU 利用率 (%)",
          "refId": "A"
        },
        {
          "expr": "avg by (hostname) (rate(node_cpu_seconds_total{job=\"linux_servers\",site_name=~\"$site\",hostname=~\"$device\",mode=\"user\"}[5m])) * 100",
          "legendFormat": "{{site_name}} / {{hostname}} 用户态 (user %)",
          "refId": "B"
        },
        {
          "expr": "avg by (hostname) (rate(node_cpu_seconds_total{job=\"linux_servers\",site_name=~\"$site\",hostname=~\"$device\",mode=\"system\"}[5m])) * 100",
          "legendFormat": "{{site_name}} / {{hostname}} 系统态 (system %)",
          "refId": "C"
        },
        {
          "expr": "avg by (hostname) (rate(node_cpu_seconds_total{job=\"linux_servers\",site_name=~\"$site\",hostname=~\"$device\",mode=\"iowait\"}[5m])) * 100",
          "legendFormat": "{{site_name}} / {{hostname}} I/O等待 (iowait %)",
          "refId": "D"
        }
      ]
    },
    {
      "id": 8,
      "title": "物理内存与 Swap 分布走势",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "数据暂不可用",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "none",
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "node_memory_MemTotal_bytes{job=\"linux_servers\",site_name=~\"$site\",hostname=~\"$device\"} - node_memory_MemAvailable_bytes{job=\"linux_servers\",site_name=~\"$site\",hostname=~\"$device\"}",
          "legendFormat": "{{site_name}} / {{hostname}} 内存已用量",
          "refId": "A"
        },
        {
          "expr": "node_memory_MemAvailable_bytes{job=\"linux_servers\",site_name=~\"$site\",hostname=~\"$device\"}",
          "legendFormat": "{{site_name}} / {{hostname}} 可用物理内存",
          "refId": "B"
        },
        {
          "expr": "node_memory_Cached_bytes{job=\"linux_servers\",site_name=~\"$site\",hostname=~\"$device\"} + node_memory_Buffers_bytes{job=\"linux_servers\",site_name=~\"$site\",hostname=~\"$device\"}",
          "legendFormat": "{{site_name}} / {{hostname}} 缓冲与缓存 (Buffers+Cache)",
          "refId": "C"
        },
        {
          "expr": "node_memory_SwapTotal_bytes{job=\"linux_servers\",site_name=~\"$site\",hostname=~\"$device\"} - node_memory_SwapFree_bytes{job=\"linux_servers\",site_name=~\"$site\",hostname=~\"$device\"}",
          "legendFormat": "{{site_name}} / {{hostname}} Swap 已用量",
          "refId": "D"
        },
        {
          "expr": "node_memory_MemTotal_bytes{job=\"linux_servers\",site_name=~\"$site\",hostname=~\"$device\"}",
          "legendFormat": "{{site_name}} / {{hostname}} 物理内存总量 (Total)",
          "refId": "E"
        }
      ]
    },
