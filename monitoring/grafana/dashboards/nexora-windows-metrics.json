        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (instance, nic) (rate(windows_net_bytes_received_total{instance=~\"$device\"}[5m]) * 8)",
          "legendFormat": "{{instance}} - {{nic}} 接收",
          "refId": "A"
        },
        {
          "expr": "sum by (instance, nic) (rate(windows_net_bytes_sent_total{instance=~\"$device\"}[5m]) * 8)",
          "legendFormat": "{{instance}} - {{nic}} 发送",
          "refId": "B"
