      "targets": [
        {
          "expr": "topk(10, sum by (asset_id) (rate(ifHCInOctets{site_id=~\"$site\",asset_id=~\"$device\"}[5m]) * 8 + rate(ifHCOutOctets{site_id=~\"$site\",asset_id=~\"$device\"}[5m]) * 8))",
