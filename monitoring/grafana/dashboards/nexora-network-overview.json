          "expr": "max by (instance, vendor) (cpmCPUTotal1minRev{site_name=~\"$site\",vendor=~\"$vendor\",role=~\"$role\"} or hh3cEntityExtCpuUsage{site_name=~\"$site\",vendor=~\"$vendor\",role=~\"$role\"} or hwEntityCpuUsage{site_name=~\"$site\",vendor=~\"$vendor\",role=~\"$role\"} or ruijieCpuCostRate{site_name=~\"$site\",vendor=~\"$vendor\",role=~\"$role\"} or jnxOperatingCPU{site_name=~\"$site\",vendor=~\"$vendor\",role=~\"$role\"} or fnSysCpuUsage{site_name=~\"$site\",vendor=~\"$vendor\",role=~\"$role\"} or zteCpuRate{site_name=~\"$site\",vendor=~\"$vendor\",role=~\"$role\"} or mpCpuUtilization5Min{site_name=~\"$site\",vendor=~\"$vendor\",role=~\"$role\"} or dptechCpuUsage{site_name=~\"$site\",vendor=~\"$vendor\",role=~\"$role\"} or hillstoneCPUUtilization{site_name=~\"$site\",vendor=~\"$vendor\",role=~\"$role\"} or sangforCpuUsage{site_name=~\"$site\",vendor=~\"$vendor\",role=~\"$role\"} or dcnCpuUsage{site_name=~\"$site\",vendor=~\"$vendor\",role=~\"$role\"}) * on(instance) group_left(sysName) (last_over_time(sysName{sysName=~\"$device\"}[1d]) * 0 + 1)",
