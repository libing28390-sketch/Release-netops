          "instant": true,
          "refId": "A"
        }
      ],
      "title": "设备带宽排行",
      "type": "table"
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "设备 CPU 使用率",
      "datasource": {"type": "prometheus", "uid": "nexora-victoriametrics"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []},
      "targets": [{"expr": "max by (asset_id, vendor) (cpmCPUTotal1minRev{site_id=~\"$site\",asset_id=~\"$device\"} or hh3cEntityExtCpuUsage{site_id=~\"$site\",asset_id=~\"$device\"} or hwEntityCpuUsage{site_id=~\"$site\",asset_id=~\"$device\"})", "legendFormat": "{{asset_id}} · {{vendor}}", "refId": "A"}]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "设备内存使用率",
      "datasource": {"type": "prometheus", "uid": "nexora-victoriametrics"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []},
      "targets": [{"expr": "max by (asset_id, vendor) (hh3cEntityExtMemUsage{site_id=~\"$site\",asset_id=~\"$device\"} or hwEntityMemUsage{site_id=~\"$site\",asset_id=~\"$device\"})", "legendFormat": "{{asset_id}} · {{vendor}}", "refId": "A"}]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "设备温度",
      "datasource": {"type": "prometheus", "uid": "nexora-victoriametrics"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "fieldConfig": {"defaults": {"unit": "celsius"}, "overrides": []},
      "targets": [{"expr": "max by (asset_id, vendor) (hh3cEntityExtTemperature{site_id=~\"$site\",asset_id=~\"$device\"} or hwEntityTemperature{site_id=~\"$site\",asset_id=~\"$device\"} or entSensorValue{site_id=~\"$site\",asset_id=~\"$device\"})", "legendFormat": "{{asset_id}} · {{vendor}}", "refId": "A"}]
    }
