{
  "annotations": {
    "list": []
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "受纳管 Windows 主机数",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "count(count by (hostname) (windows_cpu_time_total or windows_os_info)) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "平均 CPU 使用率",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#E0B400",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "avg(100 - (rate(windows_cpu_time_total{site_name=~\"$site\",hostname=~\"$device\",mode=\"idle\"}[5m]) * 100) or hrProcessorLoad{site_name=~\"$site\",hostname=~\"$device\"}) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "平均物理内存使用率",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#E0B400",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "avg((1 - (windows_os_physical_memory_free_bytes{site_name=~\"$site\",hostname=~\"$device\"} / windows_cs_physical_memory_bytes{site_name=~\"$site\",hostname=~\"$device\"})) * 100) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "远程桌面活跃会话",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(windows_terminal_services_active_sessions{site_name=~\"$site\",hostname=~\"$device\"}) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Windows CPU 使用率走势 (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "100 - (rate(windows_cpu_time_total{site_name=~\"$site\",hostname=~\"$device\",mode=\"idle\"}[5m]) * 100) or hrProcessorLoad{site_name=~\"$site\",hostname=~\"$device\"}",
          "legendFormat": "{{hostname}} {{core}} CPU",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "物理内存使用率与可用内存走势",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "(1 - (windows_os_physical_memory_free_bytes{site_name=~\"$site\",hostname=~\"$device\"} / windows_cs_physical_memory_bytes{site_name=~\"$site\",hostname=~\"$device\"})) * 100",
          "legendFormat": "{{hostname}} 内存使用率 (%)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "逻辑磁盘驱动器空间利用率 Top 10",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "数值"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "expr": "topk(10, max by (hostname, instance, volume) ((1 - (windows_logical_disk_free_bytes{site_name=~\"$site\",hostname=~\"$device\"} / windows_logical_disk_size_bytes{site_name=~\"$site\",hostname=~\"$device\"})) * 100))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "ifIndex": true,
              "asset_id": true,
              "nexora_asset_id": true,
              "nexora_hostname": true,
              "nexora_module": true,
              "nexora_platform": true,
              "nexora_role": true,
              "nexora_site_id": true,
              "nexora_site_name": true,
              "nexora_tenant_id": true,
              "nexora_vendor": true,
              "job": true,
              "tenant_id": true,
              "site_id": true,
              "site_name": true,
              "platform": true
            },
            "indexByName": {
              "hostname": 0,
              "instance": 1,
              "ifDescr": 2,
              "ifName": 3,
              "vendor": 4,
              "role": 5,
              "Value": 6
            },
            "renameByName": {
              "hostname": "设备名称",
              "instance": "管理 IP",
              "ifDescr": "接口全称",
              "ifName": "接口名称",
              "vendor": "厂商",
              "role": "角色",
              "Value": "卷使用率",
              "volume": "驱动器盘符"
            }
          }
        }
      ]
    },
    {
      "id": 8,
      "title": "逻辑磁盘读写延迟走势 (秒)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "rate(windows_logical_disk_read_seconds_total{site_name=~\"$site\",hostname=~\"$device\"}[5m]) / (rate(windows_logical_disk_reads_total{site_name=~\"$site\",hostname=~\"$device\"}[5m]) > 0)",
          "legendFormat": "{{hostname}} {{volume}} 读延迟",
          "refId": "A"
        },
        {
          "expr": "rate(windows_logical_disk_write_seconds_total{site_name=~\"$site\",hostname=~\"$device\"}[5m]) / (rate(windows_logical_disk_writes_total{site_name=~\"$site\",hostname=~\"$device\"}[5m]) > 0)",
          "legendFormat": "{{hostname}} {{volume}} 写延迟",
          "refId": "B"
        }
      ]
    },
    {
      "id": 9,
      "title": "网络适配器吞吐走势 (bps)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (hostname, nic) (rate(windows_net_bytes_received_total{site_name=~\"$site\",hostname=~\"$device\"}[5m]) * 8)",
          "legendFormat": "{{hostname}} {{nic}} 接收",
          "refId": "A"
        },
        {
          "expr": "sum by (hostname, nic) (rate(windows_net_bytes_sent_total{site_name=~\"$site\",hostname=~\"$device\"}[5m]) * 8)",
          "legendFormat": "{{hostname}} {{nic}} 发送",
          "refId": "B"
        }
      ]
    },
    {
      "id": 10,
      "title": "主机运行时间清单 (Uptime)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "数值"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "expr": "windows_system_system_up_time{site_name=~\"$site\",hostname=~\"$device\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "ifIndex": true,
              "asset_id": true,
              "nexora_asset_id": true,
              "nexora_hostname": true,
              "nexora_module": true,
              "nexora_platform": true,
              "nexora_role": true,
              "nexora_site_id": true,
              "nexora_site_name": true,
              "nexora_tenant_id": true,
              "nexora_vendor": true,
              "job": true,
              "tenant_id": true,
              "site_id": true,
              "site_name": true,
              "platform": true
            },
            "indexByName": {
              "hostname": 0,
              "instance": 1,
              "ifDescr": 2,
              "ifName": 3,
              "vendor": 4,
              "role": 5,
              "Value": 6
            },
            "renameByName": {
              "hostname": "设备名称",
              "instance": "管理 IP",
              "ifDescr": "接口全称",
              "ifName": "接口名称",
              "vendor": "厂商",
              "role": "角色",
              "Value": "已运行时间 (秒)"
            }
          }
        }
      ]
    }
