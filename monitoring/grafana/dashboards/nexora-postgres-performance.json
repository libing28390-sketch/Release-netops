    {
      "id": 7,
      "title": "数据库 Shared Buffer 命中率",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "暂无采集数据",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#3B82F6",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "暂无采集数据",
                  "color": "#64748B"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "暂无采集数据",
                  "color": "#64748B"
                }
              }
            }
          ],
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto",
        "minVizWidth": 75,
        "minVizHeight": 75
      },
      "targets": [
        {
          "expr": "100 * sum(rate(pg_stat_database_blks_hit{job=\"platform_postgres_exporter\",datname=~\"$datname\"}[5m])) / (sum(rate(pg_stat_database_blks_hit{job=\"platform_postgres_exporter\",datname=~\"$datname\"}[5m])) + sum(rate(pg_stat_database_blks_read{job=\"platform_postgres_exporter\",datname=~\"$datname\"}[5m])))",
          "refId": "A",
          "instant": true
        }
      ],
      "description": "数据库级 Shared Buffer 内存缓存命中率（通常建议 >95%）；该指标反映库级整体缓存效率，不属于单条 SQL。"
