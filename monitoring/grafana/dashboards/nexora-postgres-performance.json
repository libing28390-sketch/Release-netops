    {
      "id": 1,
      "title": "Exporter 抓取状态",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "暂无采集数据",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#64748B",
                "value": null
              },
              {
                "color": "#F43F5E",
                "value": 0
              },
              {
                "color": "#22C55E",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "正常",
                  "color": "#22C55E"
                },
                "0": {
                  "text": "失败",
                  "color": "#F43F5E"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "暂无采集数据",
                  "color": "#64748B"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "暂无采集数据",
                  "color": "#64748B"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "text": {
          "titleSize": 13,
          "valueSize": 28
        },
        "wideLayout": true
      },
      "targets": [
        {
          "expr": "min(up{job=\"platform_postgres_exporter\"})",
          "refId": "A",
          "instant": true
        }
      ],
      "description": "数据库监控采集器（Exporter）当前在线连通状态。"
    },
