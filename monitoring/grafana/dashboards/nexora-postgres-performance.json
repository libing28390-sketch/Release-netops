    {
      "id": 10,
      "title": "执行耗时速率 Top 10",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "暂无采集数据",
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "footer": {
          "show": false
        },
        "enablePagination": true
      },
      "targets": [
        {
          "expr": "topk(10, sum by (datname, user, queryid) (rate(pg_stat_statements_seconds_total{job=\"platform_postgres_exporter\",datname=~\"$datname\",user=~\"$db_user\"}[5m])))",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "indexByName": {
              "datname": 0,
              "user": 1,
              "queryid": 2,
              "Value": 3
            },
            "renameByName": {
              "datname": "数据库",
              "user": "数据库用户",
              "queryid": "Query ID",
              "Value": "执行耗时速率（秒 / 秒）"
            }
          }
        }
      ],
      "description": "按数据库、用户和 Query ID 汇总 Top 10，不读取 SQL 文本。"
    },
