      "targets": [
        {
          "expr": "1000 * sum(rate(pg_stat_statements_seconds_total{job=\"platform_postgres_exporter\",datname=~\"$datname\",user=~\"$db_user\"}[5m])) / sum(rate(pg_stat_statements_calls_total{job=\"platform_postgres_exporter\",datname=~\"$datname\",user=~\"$db_user\"}[5m]))",
