    {
      "id": 9,
      "title": "平台指标端点状态",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "暂无采集数据",
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "状态"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "UP",
                        "color": "#22C55E"
                      },
                      "0": {
                        "text": "DOWN",
                        "color": "#F43F5E"
                      }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "null",
                      "result": {
                        "text": "暂无采集数据",
                        "color": "#64748B"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "footer": {
          "show": false
        },
        "enablePagination": true
      },
      "targets": [
        {
          "expr": "up{job=~\"platform_api|platform_victoriametrics|platform_vmagent|platform_snmp_exporter|platform_grafana|platform_cadvisor\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "indexByName": {
              "job": 0,
              "instance": 1,
              "Value": 2
            },
            "renameByName": {
              "job": "采集作业",
              "instance": "目标",
              "Value": "状态"
            }
          }
        }
      ],
      "description": "列出所有平台组件采集端点的实时抓取状态与耗时，便于定位内部组件异常。"
    },
