        "defaults": {
          "unit": "none",
          "noValue": "暂无采集数据",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#22C55E",
                "value": null
              },
              {
                "color": "#F59E0B",
                "value": 1
              },
              {
                "color": "#F43F5E",
                "value": 5
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "暂无采集数据",
                  "color": "#64748B"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "暂无采集数据",
                  "color": "#64748B"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
