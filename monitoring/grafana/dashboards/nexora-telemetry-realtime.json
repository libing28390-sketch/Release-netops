      "targets": [
        {
          "refId": "A",
          "expr": "count({__name__=~\"nexora_telemetry_.*\", vendor=~\"$vendor\", hostname=~\"$hostname\"})",
          "legendFormat": "活跃序列"
        }
      ],
      "description": "当前活跃采集的遥测指标时间序列总数，用于评估秒级推流规模与采集负载。"
    },
    {
      "id": 3,
      "title": "最高设备 CPU 利用率",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "暂无数据",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto",
        "minVizWidth": 75,
        "minVizHeight": 75
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(nexora_telemetry_h3c_cpu_usage_percent{vendor=~\"$vendor\", hostname=~\"$hostname\"} or nexora_telemetry_huawei_cpu_system_usage{vendor=~\"$vendor\", hostname=~\"$hostname\"})",
          "legendFormat": "最高 CPU"
        }
      ],
      "description": "在线推流设备中的最高单板/核心 CPU 利用率峰值。"
    },
