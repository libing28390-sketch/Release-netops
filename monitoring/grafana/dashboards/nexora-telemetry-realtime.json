    {
      "id": 9,
      "title": "接口入向实时速率 (bps) / 累计字节",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "noValue": "暂无接口入向流量数据",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 26,
            "showPoints": "never",
            "lineWidth": 2,
            "gradientMode": "opacity",
            "spanNulls": true
          }
