        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "title": "在线推流设备数",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (hostname) ({__name__=~\"nexora_telemetry_.*\", vendor=~\"$vendor\", hostname=~\"$hostname\"}))",
          "legendFormat": "设备数"
        }
      ],
      "description": "当前正在向平台主动推送 gRPC Telemetry 遥测数据的网络设备总数。"
    },
    {
      "id": 2,
      "title": "活跃遥测指标序列数",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
