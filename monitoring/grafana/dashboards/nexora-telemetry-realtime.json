          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(nexora_telemetry_h3c_interface_in_octets{vendor=~\"$vendor\", hostname=~\"$hostname\"}[2m]) * 8",
          "legendFormat": "{{hostname}} {{interface_name}} In (H3C)"
        },
        {
          "refId": "B",
