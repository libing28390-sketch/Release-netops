# nexora-action-code: get_lldp_neighbors
Value Required LOCAL_INTERFACE ((?:[0-9]+)?[A-Za-z][A-Za-z0-9-]*\s*\d[\w/.-]*)
Value Required NEIGHBOR_NAME (\S+)
Value Required NEIGHBOR_INTERFACE ((?:[0-9]+)?[A-Za-z][A-Za-z0-9-]*\s*\d[\w/.-]*)
Value EXPIRED_TIME (\d+)

Start
  ^\s*Local\s+Interface\s+Exptime\(s\)\s+Neighbor\s+Interface\s+Neighbor\s+Device\s*$$ -> ExpiryFirst
  ^\s*Local\s+Intf\s+Neighbor\s+Dev\s+Neighbor\s+Intf\s+Exptime(?:\(s\))?\s*$$ -> NameFirst
  ^\s*<[^>]+>.*$$
  ^\s*[-=]+\s*$$
  ^\s*$$
  ^. -> Error

ExpiryFirst
  ^\s*${LOCAL_INTERFACE}\s+${EXPIRED_TIME}\s+${NEIGHBOR_INTERFACE}\s+${NEIGHBOR_NAME}\s*$$ -> Record
  ^\s*[-=]+\s*$$
  ^\s*Total\s+.*$$
  ^\s*<[^>]+>.*$$
  ^\s*$$
  ^. -> Error

NameFirst
  ^\s*${LOCAL_INTERFACE}\s+${NEIGHBOR_NAME}\s+${NEIGHBOR_INTERFACE}\s+${EXPIRED_TIME}\s*$$ -> Record
  ^\s*[-=]+\s*$$
  ^\s*Total\s+.*$$
  ^\s*<[^>]+>.*$$
  ^\s*$$
  ^. -> Error
