# nexora-action-code: get_bgp_neighbors
# Comware V5 uses ``display bgp peer`` for the global peer summary.
Value Filldown LOCAL_ROUTER_ID ((?:\d{1,3}\.){3}\d{1,3})
Value Filldown LOCAL_AS_NUMBER (\d+)
Value Required PEER ((?:\d{1,3}\.){3}\d{1,3})
Value Required REMOTE_AS (\d+(?:\.\d+)?)
Value MSG_RECEIVED (\d+)
Value MSG_SENT (\d+)
Value OUT_QUEUE (\d+)
Value PREFIX_RECEIVED (\d+)
Value UP_DOWN (\S+)
Value Required STATE (\S+(?:\s+\S+)?)

Start
  ^\s*BGP\s+local\s+router\s+ID:\s+${LOCAL_ROUTER_ID}\s*$$
  ^\s*Local\s+AS\s+number:\s+${LOCAL_AS_NUMBER}\s*$$
  ^\s*[*^]?\s*${PEER}\s+${REMOTE_AS}\s+${MSG_RECEIVED}\s+${MSG_SENT}\s+${OUT_QUEUE}\s+${PREFIX_RECEIVED}\s+${UP_DOWN}\s+${STATE}\s*$$ -> Record
  ^\s*$$
  ^.*$$
