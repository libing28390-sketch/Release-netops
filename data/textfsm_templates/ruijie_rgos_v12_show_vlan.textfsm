# nexora-action-code: get_vlan_table
Value Required VLAN_ID (\d+)
Value VLAN_NAME (\S+)
Value STATUS (\S+)
Value List PORTS (\S(?:.*?\S)?)

Start
  ^VLAN\s+Name\s+Status\s+Ports -> Table
  ^.*#\s*show\s+ -> Next
  ^\s*$$
  ^. -> Next

Table
  ^-+ -> Next
  ^\s*\d+\s+\S+\s+\S+ -> Continue.Record
  ^\s*${VLAN_ID}\s+${VLAN_NAME}\s+${STATUS}(?:\s+${PORTS})?\s*$$
  ^\s+(?=[A-Za-z][A-Za-z-]*\s*\d+[/.])${PORTS}\s*$$
  ^\s*$$
  ^. -> Next
