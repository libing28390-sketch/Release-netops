# nexora-action-code: get_transceivers
# Official H3C S9500 Command Manual, Release2132 [V2.03], section 1.1.12.
# https://www.h3c.com/en/d_200806/607528_294551_0.htm
Value Required INTERFACE (\S+)
Value TRANSCEIVER_TYPE (.+)
Value CONNECTOR_TYPE (.+)
Value WAVELENGTH (\S+)
Value TRANSFER_DISTANCE (.+)
Value DIGITAL_DIAGNOSTIC_MONITORING (\S+)
Value VENDOR_NAME (\S+)
Value ORDERING_NAME (\S+)

Start
  ^${INTERFACE}\s+transceiver\s+information:
  ^\s*Transceiver\s+Type\s*:\s*${TRANSCEIVER_TYPE}\s*$$
  ^\s*Connector\s+Type\s*:\s*${CONNECTOR_TYPE}\s*$$
  ^\s*Wavelength\(nm\)\s*:\s*${WAVELENGTH}
  ^\s*Transfer\s+Distance(?:\(m\)|\(km\))?\s*:\s*${TRANSFER_DISTANCE}\s*$$
  ^\s*Digital\s+Diagnostic\s+Monitoring\s*:\s*${DIGITAL_DIAGNOSTIC_MONITORING}
  ^\s*Vendor\s+Name\s*:\s*${VENDOR_NAME}
  ^\s*Ordering\s+Name\s*:\s*${ORDERING_NAME}\s*$$ -> Record
  ^\s*$$
  ^. -> Next

EOF
