Value LOCAL_DISCRIMINATOR (\d+)
Value REMOTE_DISCRIMINATOR (\d+)
Value SOURCE_IP (\d+\.\d+\.\d+\.\d+)
Value DESTINATION_IP (\d+\.\d+\.\d+\.\d+)
Value STATUS (\S+)
Value HOLDTIME (\S+)
Value INTERFACE (\S+)

Start
  ^\s*${LOCAL_DISCRIMINATOR}/${REMOTE_DISCRIMINATOR}\s+${SOURCE_IP}\s+${DESTINATION_IP}\s+${STATUS}\s+${HOLDTIME}\s+${INTERFACE}\s*$$ -> Record
  ^\s*${SOURCE_IP}\s+${DESTINATION_IP}\s+${STATUS}\s+${HOLDTIME}\s+${INTERFACE}\s*$$ -> Record
  ^\s*${LOCAL_DISCRIMINATOR}\s+${REMOTE_DISCRIMINATOR}\s+${SOURCE_IP}\s+${DESTINATION_IP}\s+${STATUS}\s+${INTERFACE}\s*$$ -> Record
